#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
install_dir=${HOME}/.local/bin
target=$install_dir/skwf

mkdir -p "$install_dir"
ln -sfn "$repo_root/scripts/skwf" "$target"
printf 'Installed skwf -> %s\n' "$repo_root/scripts/skwf"

case ":${PATH}:" in
  *":${install_dir}:"*) ;;
  *)
    printf '%s\n' "Add ${install_dir} to PATH, then open a new terminal:" \
      "  export PATH=\"${install_dir}:\$PATH\""
    ;;
esac
