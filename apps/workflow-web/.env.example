WORKFLOW_DATA_MODE=local
DATABASE_URL=postgres://workflow:workflow@workflow-postgres:5432/workflow
WORKFLOW_WORKER_URL=http://workflow-worker:8787
ARTIFACTS_ROOT=/artifacts
# Exactly 32 bytes after base64 decoding. Generate a private value before any deployment.
# Example command: openssl rand -base64 32
WORKFLOW_RUNTIME_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Local MCP calls this address from the host. It is not a browser-visible value.
SENDKIT_WORKFLOW_WEB_URL=http://127.0.0.1:3000
# Configure source workspace allowlists only in the local MCP client environment,
# never in this web app environment. Example:
# SENDKIT_SOURCE_WORKSPACES={"hcns":{"root":"/absolute/path/to/hcns"}}
